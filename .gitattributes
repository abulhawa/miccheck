# Pinned model assets are verified byte-for-byte against manifest.json.
# Preserve upstream bytes (including CSV/license line endings) on every OS.
apps/web/public/models/** -text

# Hashed annotation snapshots use identical LF bytes on every OS.
apps/web/e2e/fixtures/human-speech/annotations*.json text eol=lf
apps/web/e2e/fixtures/human-speech/groq-large-v3-responses.json text eol=lf
docs/ai-annotation-evaluation.json text eol=lf
docs/groq-annotation-evaluation.json text eol=lf

# Preserve exact STARSS22 fixture and provenance bytes on every OS.
apps/web/e2e/fixtures/starss22/** -text

# Continuation evaluation freezes source, CSV, license and protocol bytes.
apps/web/e2e/fixtures/starss22-vad/** -text whitespace=cr-at-eol
# This verbatim upstream document intentionally contains trailing spaces.
apps/web/e2e/fixtures/starss22-vad/UPSTREAM_README.md -whitespace
# The candidate function and cached probability traces have frozen hashes.
apps/web/lib/ai/silero.ts text eol=lf
docs/starss22-app-length-*-results.json text eol=lf
